{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/rules/**/*.js"],
  "exclude": [
    "node_modules",
    "dist",
    "src/rules/**/*.test.js",
    "src/App.jsx",
    "src/main.jsx",
    "src/engine",
    "src/selectors",
    "src/presentation",
    "src/components",
    "test"
  ]
}
