{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/rules/**/*.ts",
    "src/selectors/**/*.ts",
    "src/persistence/**/*.ts",
    "src/presentation/**/*.ts",
    "src/engine/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/rules/**/*.test.ts"]
}
